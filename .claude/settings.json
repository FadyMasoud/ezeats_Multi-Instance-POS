{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:int)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run build -w *)",
      "Bash(npm run db:generate -- --name *)",
      "Bash(npm run db:check)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc -p * --noEmit)",
      "Bash(npx biome check *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Edit(apps/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(*.md)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm run db:migrate)",
      "Bash(npm run test:chaos)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose kill *)",
      "Edit(.claude/**)",
      "Edit(.husky/**)",
      "Edit(.github/**)",
      "Edit(docker-compose.yml)",
      "Edit(Dockerfile)",
      "Edit(package.json)",
      "Edit(apps/*/package.json)",
      "Edit(biome.json)",
      "Edit(tsconfig.base.json)",
      "Edit(vitest.workspace.ts)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(apps/api/drizzle/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(npx drizzle-kit push *)",
      "Bash(drizzle-kit push *)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v *)",
      "Bash(npm publish *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-edit.mjs\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-stop.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
