{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignore": ["**/dist/**", "**/drizzle/meta/**", "docs/.build/**", "**/*.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "parser": { "unsafeParameterDecoratorsEnabled": true },
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "off",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error"
      },
      "suspicious": { "noExplicitAny": "error", "noConsole": "off" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "complexity": { "noStaticOnlyClass": "off" }
    }
  }
}
