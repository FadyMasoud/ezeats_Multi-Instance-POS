# Copy to .env for local (non-Docker) runs. Docker Compose does not need this file.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ezeats
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ezeats_test

# Fake POS base URL used by the API workers
POS_BASE_URL=http://localhost:4000

# Local-development operator token for /admin/* and POST /checks/:id/sync/retry.
# Not production authentication: replace with real operator auth before deploying.
ADMIN_TOKEN=dev-admin-token

# Fake POS failure modes (0..1)
FAIL_RATE=0
TIMEOUT_AFTER_CREATE_RATE=0
SLOW_RATE=0
